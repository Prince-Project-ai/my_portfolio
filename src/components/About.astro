---
import { site, education, hobbies } from "../data/site";
import Icon from "./Icon.astro";
---

<section id="about" class="section">
  <div>
    <div class="section-head mb-6">
      <p class="eyebrow">04 — About</p>
    </div>

    <!-- Strict Architectural Matrix -->
    <div class="relative">
      
      <!-- Headline / Quote -->
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-display leading-tight tracking-tight text-black">
        I'd rather understand why something is slow<br/>
        <span class="italic text-moss">— than guess at a patch.</span>
      </h2>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-10 mt-6 border-t border-dashed border-rule-strong pt-10">
        
        <!-- Left: Operator Bio -->
        <div class="lg:col-span-7">
          <p class="tag mb-5 text-moss">Operator Bio</p>
          <div class="space-y-6 text-base leading-relaxed text-ink">
            <p>
              I started with the MERN stack, then moved into Angular professionally when
              I joined Softrefine Technology. Working on live enterprise platforms
              taught me the part tutorials skip — how software behaves once real users
              depend on it.
            </p>
            <p>
              My work sits across the stack. On the front I'm strongest in Angular with
              TypeScript, and I build in React too. Behind it I write Node and Express,
              work in Core Java, and design REST interfaces against PostgreSQL, MySQL,
              and MongoDB. I care about the seam between the two, where most real problems
              actually live.
            </p>
          </div>
        </div>

        <!-- Right: Technical Specs -->
        <div class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-10 lg:border-l lg:border-rule-strong lg:pl-10">
          
          <!-- Education -->
          <div class="sm:col-span-2">
            <p class="tag mb-5">Education Matrix</p>
            <ul class="space-y-5">
              {
                education.map((entry) => (
                  <li class="border-l-2 border-moss pl-4">
                    <p class="font-mono text-[0.7rem] uppercase tracking-widest text-ink-faint">{entry.period}</p>
                    <p class="mt-1 text-sm font-medium text-ink">{entry.degree}</p>
                    <p class="mt-0.5 text-sm text-ink-soft">{entry.school}</p>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Languages -->
          <div>
            <p class="tag mb-4">Languages</p>
            <ul class="flex flex-col gap-2 font-mono text-sm text-ink">
              <li class="flex items-center gap-2"><span class="text-moss text-xs opacity-70">▹</span> Gujarati (native)</li>
              <li class="flex items-center gap-2"><span class="text-moss text-xs opacity-70">▹</span> Hindi</li>
              <li class="flex items-center gap-2"><span class="text-moss text-xs opacity-70">▹</span> English</li>
            </ul>
          </div>

          <!-- Hobbies -->
          <div>
            <p class="tag mb-4">Hobbies</p>
            <ul class="flex flex-col gap-2 font-mono text-sm text-ink">
              {hobbies.map(h => <li class="flex items-center gap-2"><span class="text-moss text-xs opacity-70">▹</span> {h}</li>)}
            </ul>
          </div>

          <!-- Status Box -->
          <div class="sm:col-span-2">
            <p class="tag mb-3">Current Status</p>
            <div class="border border-dashed border-rule-strong p-4 bg-[var(--color-rule-faint)]">
              <p class="font-mono text-[0.8rem] leading-relaxed text-ink">
                > Building Factory OS.<br/>
                > Developing AI-Powered Enterprise ATS.<br/>
                > Exploring system architecture.<br/>
                <span class="animate-pulse font-bold text-moss">_</span>
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Module Footer / Elsewhere -->
      <!-- <div class="mt-12 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-dashed border-rule-strong pt-6">
        <div class="flex items-center gap-4">
          <p class="tag">Network Links</p>
          <div class="flex gap-3">
            <a
              href={site.github}
              target="_blank"
              rel="noopener noreferrer"
              class="icon-btn hover:border-moss hover:text-moss transition-colors"
              aria-label="GitHub profile"
            >
              <Icon name="github" size={16} />
            </a>
            <a
              href={site.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="icon-btn hover:border-moss hover:text-moss transition-colors"
              aria-label="LinkedIn profile"
            >
              <Icon name="linkedin" size={16} />
            </a>
          </div>
        </div>
        <p class="font-mono text-[0.65rem] uppercase tracking-widest text-ink-faint">
          End of Module 04
        </p>
      </div> -->
      
    </div>
  </div>
</section>
