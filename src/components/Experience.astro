---
import { experience } from "../data/site";
import ModulesDiagram from "./ModulesDiagram.astro";
---

<section id="experience" class="rule-t section">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">02 — Experience</p>
      <h2 class="mt-3 text-headline">Where I've done the work</h2>
    </div>

    {
      experience.map((role) => (
        <div>
          <!-- Role header spans the full width -->
          <div class="flex flex-col gap-1 border-b border-rule pb-6 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
            <div>
              <h3 class="font-display text-title">
                {role.role} <span class="italic text-moss">— {role.focus}</span>
              </h3>
              <p class="mt-1 text-sm text-ink-soft">
                {role.company} · {role.location}
              </p>
            </div>
            <p class="meta shrink-0">{role.period}</p>
          </div>

          <div class="grid-12 mt-10">
            <!-- Narrative -->
            <div class="col-span-12 lg:col-span-7">
              <p class="measure leading-relaxed">{role.summary}</p>

              <ul class="mt-8 space-y-5 border-t border-rule pt-6">
                {role.points.map((point) => (
                  <li class="measure">
                    <p class="tag">{point.label}</p>
                    <p class="mt-1 leading-relaxed text-ink-soft">{point.text}</p>
                  </li>
                ))}
              </ul>

              <div class="mt-8 border-t border-rule pt-5">
                <p class="tag">Stack</p>
                <ul class="mt-2 flex flex-wrap gap-1.5">
                  {role.stack.map((tech) => (
                    <li class="pill">{tech}</li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Interactive module map fills the right column -->
            <div class="col-span-12 mt-12 lg:col-span-4 lg:col-start-9 lg:mt-0">
              <p class="tag mb-4">Modules I look after</p>
              <ModulesDiagram />
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
