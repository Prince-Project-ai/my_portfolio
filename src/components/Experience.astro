---
import { experience } from "../data/site";
---

<section id="experience" class="section">
  <div>
    <div class="section-head">
      <p class="eyebrow">02 — Experience</p>
      <h2 class="mt-3 text-headline">Where I've done the work</h2>
    </div>

    <div class="mt-10 border-t border-dashed border-rule-strong">
      {
        experience.map((role) => (
          <article class="grid-12 gap-y-8 border-b border-dashed border-rule-strong py-10">
            <!-- Left Rail: Meta Data -->
            <div class="col-span-12 lg:col-span-4">
              <div class="sticky top-24">
                <h3 class="font-display text-2xl text-black leading-tight">
                  {role.role}
                </h3>
                <p class="mt-2 font-display text-lg text-moss">
                  {role.company}
                </p>
                
                <div class="mt-5 flex flex-col gap-1.5 border-l border-dashed border-rule-strong pl-4">
                  <p class="font-mono text-sm text-ink">{role.period}</p>
                  <p class="text-sm text-ink">{role.location}</p>
                </div>
                
                <div class="mt-6">
                  <p class="tag mb-2">Core Focus</p>
                  <p class="text-sm text-ink">{role.focus}</p>
                </div>
              </div>
            </div>

            <!-- Right Rail: Details -->
            <div class="col-span-12 lg:col-span-8 lg:border-l lg:border-dashed lg:border-rule-strong lg:pl-10">
              <p class="text-base leading-relaxed text-ink">{role.summary}</p>

              <!-- 2-column bullet grid -->
              <ul class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
                {role.points.map((point) => (
                  <li class="border-t border-dashed border-rule-strong pt-4">
                    <p class="tag">{point.label}</p>
                    <p class="mt-2 text-sm leading-relaxed text-ink">{point.text}</p>
                  </li>
                ))}
              </ul>

              <!-- Stack -->
              <div class="mt-8 border-t border-dashed border-rule-strong pt-6">
                <p class="tag mb-3">Applied Stack</p>
                <ul class="flex flex-wrap gap-1.5">
                  {role.stack.map((tech) => (
                    <li class="pill">{tech}</li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
