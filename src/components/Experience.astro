---
import { experience } from "../data/site";
---

<section id="experience" class="section">
  <div>
    <!-- Section Head: Matching Soni's "02 — RECORD / Experience" format -->
    <div class="mb-10">
      <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-moss">
        02 — RECORD
      </p>
      <h2 class="mt-2 font-display text-4xl sm:text-5xl font-bold text-black tracking-tight">
        Experience
      </h2>
    </div>

    <!-- Timeline Entries List -->
    <div class="border-t border-rule-strong">
      {
        experience.map((job) => (
          <article class="grid grid-cols-1 md:grid-cols-12 gap-y-3 gap-x-8 py-8 border-b border-rule-strong">
            <!-- Left: Date Range (approx 170-220px / 3 cols) -->
            <div class="md:col-span-3">
              <span class="font-mono text-sm text-ink-soft block font-medium">
                {job.period}
              </span>
            </div>

            <!-- Right: Role Title, Company in Terracotta, and Bullet List (9 cols) -->
            <div class="md:col-span-9">
              <h3 class="font-display text-2xl font-bold text-black leading-snug">
                {job.role}
              </h3>
              <p class="mt-1 font-sans text-sm font-semibold text-moss">
                {job.company} · {job.location}
              </p>

              <!-- Bullets matching Soni's clean bulleted list -->
              <ul class="mt-4 space-y-2.5 text-ink-soft text-sm leading-relaxed list-disc list-outside pl-4">
                {job.points.map((point) => (
                  <li class="pl-1">
                    <strong class="text-ink font-semibold">{point.label}:</strong> {point.text}
                  </li>
                ))}
              </ul>

              <!-- Technologies used -->
              {job.stack && job.stack.length > 0 && (
                <div class="mt-5 flex flex-wrap items-center gap-1.5">
                  {job.stack.map((tech) => (
                    <span class="pill font-mono text-[0.7rem]">{tech}</span>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
