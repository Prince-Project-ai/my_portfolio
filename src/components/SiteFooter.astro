---
import { site, nav } from "../data/site";
import Icon from "./Icon.astro";
import Monogram from "./Monogram.astro";
import Wordmark from "./Wordmark.astro";

const year = new Date().getFullYear();

const elsewhere = [
  { label: "GitHub", href: site.github, icon: "github" as const },
  { label: "LinkedIn", href: site.linkedin, icon: "linkedin" as const },
  { label: "X", href: site.twitter, icon: "x" as const },
];
---

<footer class="rule-t">
  <div class="wrap">
    <!-- Columns: identity, index, elsewhere, direct -->
    <div class="grid-12 gap-y-10 py-12">
      <!-- Identity -->
      <div class="col-span-12 md:col-span-4">
        <div class="flex items-center gap-4">
          <div>
            <p class="font-display text-title leading-tight text-black">{site.name}</p>
            <p class="text-sm text-ink-soft">{site.role}</p>
          </div>
        </div>

        <p class="mt-4 flex items-center gap-2 text-sm text-ink-soft">
          <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-moss"></span>
          {site.availability}
        </p>

        <a
 href={site.resume}
          download
 class="btn btn-ghost btn-sm mt-5"
 aria-label="Download my resume as a PDF"
        >
          <Icon name="download" size={14} />
          Download resume
        </a>
      </div>

      <!-- Index -->
      <nav class="col-span-6 md:col-span-2 md:col-start-6" aria-label="Footer">
        <p class="tag">Index</p>
        <ul class="mt-3 space-y-2">
          {
            nav.map((item) => (
              <li>
                <a
 href={item.href}
 class="text-sm text-ink-soft transition-colors duration-200 hover:text-moss"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Elsewhere -->
      <div class="col-span-6 md:col-span-2">
        <p class="tag">Elsewhere</p>
        <ul class="mt-3 space-y-2">
          {
            elsewhere.map((link) => (
              <li>
                <a
 href={link.href}
 target="_blank"
 rel="noopener noreferrer"
 class="flex items-center gap-2 text-sm text-ink-soft transition-colors duration-200 hover:text-moss"
                >
                  <Icon name={link.icon} size={13} />
                  {link.label}
                  <Icon name="arrow-up-right" size={11} class="text-ink-faint" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Direct -->
      <div class="col-span-12 md:col-span-3 md:col-start-10">
        <p class="tag">Direct</p>
        <ul class="mt-3 space-y-2">
          <li>
            <a href={`mailto:${site.email}`} class="link text-sm">{site.email}</a>
          </li>
          <li>
            <a href={site.phoneHref} class="link text-sm">{site.phone}</a>
          </li>
          <li class="text-sm text-ink-soft">{site.location}</li>
        </ul>
      </div>
    </div>

    <!-- Oversized signature -->
    <!-- <div class="border-t border-rule pt-10">
      <Wordmark />
    </div> -->

    <!-- Colophon -->
    <div
 class="flex flex-col gap-3 border-t border-rule py-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="meta">© {year} {site.name}. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a
 href="#top"
 class="flex items-center gap-1.5 text-sm text-ink-soft transition-colors duration-200 hover:text-moss"
        >
          Back to top
          <Icon name="arrow-up" size={13} />
        </a>
      </div>
    </div>
  </div>
</footer>
