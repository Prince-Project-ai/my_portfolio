---
import { stack } from "../data/site";

const coreCount = stack.reduce(
  (total, group) => total + group.items.filter((item) => item.core).length,
  0,
);
---

<section id="stack" class="section">
  <div>
    <div class="section-head">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">03 — Stack</p>
          <h2 class="mt-3 text-headline">What I work with</h2>
          <p class="measure text-ink-soft">
            Grouped by layer, and marked by how often I actually reach for it.
          </p>
        </div>

        <!-- Legend explains the two states -->
        <dl class="flex flex-wrap items-center gap-x-5 gap-y-2">
          <div class="flex items-center gap-2">
            <dt class="text-[0.65rem] text-moss">■</dt>
            <dd class="tag">Daily — {coreCount}</dd>
          </div>
          <div class="flex items-center gap-2">
            <dt class="text-[0.65rem] text-ink-faint opacity-50">□</dt>
            <dd class="tag">Familiar</dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Blueprint Bento Grid -->
    <div class="grid grid-cols-12 gap-6 mt-10">
      {
        stack.map((group) => {
          // Dynamic span mapping for zigzag bento layout
          const spanClass = 
            group.index === "01" ? "col-span-12 lg:col-span-8" :
            group.index === "02" ? "col-span-12 lg:col-span-4" :
            group.index === "03" ? "col-span-12 lg:col-span-4" :
            "col-span-12 lg:col-span-8";

          // Dynamic internal grid columns to balance row heights perfectly
          const innerGridClass = 
            group.index === "01" ? "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3" : // 12 items / 3 = 4 rows
            group.index === "02" ? "grid-cols-1 sm:grid-cols-2" : // 8 items / 2 = 4 rows
            group.index === "03" ? "grid-cols-1 sm:grid-cols-2 lg:grid-cols-1" : // 5 items / 1 = 5 rows
            "grid-cols-1 sm:grid-cols-2"; // 7 items / 2 = 4 rows

          return (
            <article class:list={["relative flex flex-col border border-dashed border-rule-strong p-6 md:p-8 hover:bg-rule-faint transition-colors group", spanClass]}>
              <!-- Schematic Watermark -->
              <span class="absolute top-4 right-4 text-7xl font-display font-bold text-rule-strong opacity-20 pointer-events-none select-none group-hover:text-moss group-hover:opacity-10 transition-colors">
                {group.index}
              </span>

              <div class="relative z-10 mb-8 border-l-2 border-moss pl-4">
                <h3 class="font-display text-2xl text-black leading-none">{group.group}</h3>
                <p class="mt-2 font-mono text-sm text-ink-soft">{group.note}</p>
              </div>

              <!-- Technical readout list -->
              <ul class:list={["relative z-10 grid gap-x-8 gap-y-3 mt-auto", innerGridClass]}>
                {group.items.map((item) => (
                  <li class="flex items-center justify-between border-b border-dashed border-rule-strong pb-2">
                    <div class="flex items-center gap-2 truncate">
                      <span class:list={["text-[0.65rem]", item.core ? "text-moss" : "text-ink-faint opacity-50"]}>
                        {item.core ? "■" : "□"}
                      </span>
                      <span class="font-mono text-sm text-ink truncate">{item.name}</span>
                    </div>
                    {item.core && (
                      <span class="text-[0.6rem] font-mono uppercase tracking-widest text-moss opacity-80 ml-2">Core</span>
                    )}
                  </li>
                ))}
              </ul>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
