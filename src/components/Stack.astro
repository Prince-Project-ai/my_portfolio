---
// Skills structured matching the exact 6-category layout from the reference image
const skillGroups = [
  {
    category: "Frontend",
    skills:
      "Angular V2 — V17+, TypeScript, JavaScript, PrimeNG, Angular Material, RxJS, Signals, Tailwind CSS, Bootstrap 5, SCSS, HTML5, CSS3, Responsive Design, Cross-browser Compatibility",
  },
  {
    category: "Backend & APIs",
    skills:
      "Nest.js, Node.js, Express.js, REST API Architecture, Core Java, Hibernate, Java Servlet, JWT Auth, Microservices Architecture, Postman",
  },
  {
    category: "Data & Databases",
    skills:
      "PostgreSQL, MySQL, MongoDB, SQL, Relational Schema Design, Query Optimization, Database Normalization, Indexed Collections",
  },
  {
    category: "Platforms & DevOps",
    skills:
      "Azure DevOps, Git, GitHub, Docker, Netlify, VS Code, Linux/WSL, Agile/Scrum Sprint Workflows",
  },
  {
    category: "Testing & Reliability",
    skills:
      "Postman API Testing, Functional & Regression Testing, Defect Triage, Cross-Platform Verification, API Health Validation",
  },
  {
    category: "Agentic AI",
    isAi: true,
    tag: "AI-ASSISTED",
    skills:
      "Autonomous agent workflows, agentic automation pipelines, and modern AI-assisted engineering systems accelerating full-stack delivery.",
  },
];
---

<section id="stack" class="section">
  <div>
    <!-- Section Header matching reference image: 02 — SPECIFICATION / Skills & Stack -->
    <div class="mb-10">
      <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-moss">
        02 — SPECIFICATION
      </p>
      <h2 class="mt-2 font-display text-4xl sm:text-5xl font-bold text-black tracking-tight">
        Skills & Stack
      </h2>
    </div>

    <!-- 3-Column Editorial Grid matching reference image -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-10">
      {
        skillGroups.map((group) => (
          <div class="flex flex-col justify-between">
            <div>
              <!-- Category Header with optional AI-ASSISTED tag -->
              <div class="flex items-center gap-2 mb-2">
                <h3 class="font-display text-xl sm:text-2xl font-bold text-black">
                  {group.category}
                </h3>
                {group.tag && (
                  <span class="font-sans text-[0.625rem] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-moss text-white">
                    {group.tag}
                  </span>
                )}
              </div>

              <!-- Skills prose list -->
              <p class="font-sans text-sm leading-relaxed text-ink-soft">
                {group.skills}
              </p>
            </div>

            <!-- Bottom border divider under each category -->
            <div class:list={[
              "mt-6 border-b-2",
              group.isAi ? "border-moss" : "border-black"
            ]}></div>
          </div>
        ))
      }
    </div>
  </div>
</section>
