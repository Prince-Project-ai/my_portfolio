---
// Skills structured matching the exact 6-category layout from the updated resume
const skillGroups = [
  {
    category: "Frontend",
    skills:
      "Angular (16+), React.js, TypeScript, JavaScript, Redux, RxJS, Signals, Angular Material, PrimeNG, Tailwind CSS, SCSS, HTML5, CSS3, Responsive Architecture",
  },
  {
    category: "Backend & APIs",
    skills:
      "Node.js, Express.js, NestJS, RESTful APIs, JWT Authentication, RBAC (Role-Based Access Control), Core Java, Scalable API Design",
  },
  {
    category: "Databases",
    skills:
      "MongoDB, PostgreSQL, MySQL, Supabase, SQL, Relational Schema Design, Normalization, Indexed Collections & Query Tuning",
  },
  {
    category: "Cloud & Tools",
    skills:
      "Azure, Azure DevOps, AWS, Docker, Git, GitHub, CI/CD Pipelines, Postman, VS Code, Agile/Scrum Sprints",
  },
  {
    category: "Stacks & Domains",
    skills:
      "MERN Stack, MEAN Stack, Production SaaS Platforms, CRM Systems, Manufacturing ERP, Business Process Automation",
  },
  {
    category: "AI & AI-Assisted Dev",
    isAi: true,
    tag: "AI-ASSISTED",
    skills:
      "LLM Integration, Prompt Engineering, AI-Assisted Development (Claude, OpenAI Codex, Google Antigravity, Cursor) accelerating full-stack delivery and edge case verification.",
  },
];
---

<section id="stack" class="section">
  <div>
    <!-- Section Header matching reference image: 03 — SPECIFICATION / Skills & Stack -->
    <div class="mb-10">
      <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-moss">
        03 — SPECIFICATION
      </p>
      <h2 class="mt-2 font-display text-4xl sm:text-5xl font-bold text-black tracking-tight">
        Skills & Stack
      </h2>
    </div>

    <!-- 3-Column Editorial Grid matching reference image -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-10">
      {
        skillGroups.map((group) => (
          <div class="flex flex-col justify-between">
            <div>
              <!-- Category Header with optional AI-ASSISTED tag -->
              <div class="flex items-center gap-2 mb-2">
                <h3 class="font-display text-xl sm:text-2xl font-bold text-black">
                  {group.category}
                </h3>
                {group.tag && (
                  <span class="font-sans text-[0.625rem] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-moss text-white">
                    {group.tag}
                  </span>
                )}
              </div>

              <!-- Skills prose list -->
              <p class="font-sans text-sm leading-relaxed text-ink-soft">
                {group.skills}
              </p>
            </div>

            <!-- Bottom border divider under each category -->
            <div class:list={[
              "mt-6 border-b-2",
              group.isAi ? "border-moss" : "border-black"
            ]}></div>
          </div>
        ))
      }
    </div>
  </div>
</section>
