---
import Icon from "./Icon.astro";
import { site } from "../data/site";

interface Props {
  size?: "sm" | "base";
  class?: string;
  align?: "left" | "center" | "right";
  dropUp?: boolean;
}

const {
  size = "base",
  class: className = "",
} = Astro.props;

// Direct download URL for Full Stack Developer resume
const resumeUrl = site.resume || "/Prince_Bavishi_AI_FullStack.pdf";
const resumeFilename = "Prince_Bavishi_AI_FullStack.pdf";
---

<a
  href={resumeUrl}
  download={resumeFilename}
  class={`btn btn-ghost ${size === "sm" ? "btn-sm" : ""} gap-2 group justify-center ${className}`}
  aria-label="Download Full Stack Developer Resume (PDF)"
>
  <Icon name="download" size={14} class="transition-transform group-hover:translate-y-0.5" />
  <span>Download Resume</span>
</a>
