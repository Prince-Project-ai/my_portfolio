---
import Icon from "./Icon.astro";
import { site } from "../data/site";

interface Props {
  size?: "sm" | "base";
  class?: string;
  align?: "left" | "center" | "right";
  dropUp?: boolean;
}

const {
  size = "base",
  class: className = "",
  align = "center",
  dropUp = false,
} = Astro.props;

const resumes = site.resumes ?? [
  {
    role: "Full Stack Developer",
    subtitle: "AI & Full Stack Systems",
    href: "/Prince_Bavishi_AI_FullStack.pdf",
    filename: "Prince_Bavishi_AI_FullStack.pdf",
  },
  {
    role: "Forward Deployed Engineer",
    subtitle: "Enterprise Solutions & Integration",
    href: "/Prince_Bavishi_cv_Forward_Deployed_Engineer.pdf",
    filename: "Prince_Bavishi_cv_Forward_Deployed_Engineer.pdf",
  },
];

const alignClass =
  align === "left"
    ? "left-0"
    : align === "right"
      ? "right-0"
      : "left-1/2 -translate-x-1/2";

const placementClass = dropUp ? "bottom-full mb-2" : "top-full mt-2";
const bridgeClass = dropUp
  ? "before:absolute before:inset-x-0 before:top-full before:h-3 before:content-['']"
  : "before:absolute before:inset-x-0 before:bottom-full before:h-3 before:content-['']";
---

<div class={`relative inline-block text-left resume-dropdown-container ${className}`}>
  <button
    type="button"
    class={`btn btn-ghost ${size === "sm" ? "btn-sm" : ""} gap-2 group w-full justify-center sm:justify-between sm:w-auto`}
    aria-haspopup="true"
    aria-expanded="false"
    data-resume-toggle
  >
    <Icon name="download" size={size === "sm" ? 14 : 15} />
    <span>Download resume</span>
    <span
      class="text-ink-soft group-hover:text-ink transition-transform duration-200"
      data-resume-arrow
    >
      <Icon name={dropUp ? "arrow-up" : "arrow-down"} size={11} />
    </span>
  </button>

  <div
    data-resume-menu
    hidden
    class={`absolute z-40 w-72 sm:w-80 max-w-[calc(100vw-2.5rem)] border border-rule-strong bg-paper shadow-2xl transition-all duration-150 squircle-box ${placementClass} ${alignClass} ${bridgeClass}`}
  >
    <div class="border-b border-rule-strong px-4 py-2.5 flex items-center justify-between bg-paper-warm/40 rounded-t-[34px]">
      <span class="eyebrow text-[0.65rem] text-ink-faint">Select Role</span>
      <span class="font-mono text-[0.65rem] text-moss uppercase tracking-wider font-semibold">PDF [2 Versions]</span>
    </div>

    <div class="divide-y divide-rule-strong/60">
      {
        resumes.map((item) => (
          <a
            href={item.href}
            download={item.filename}
            class="flex items-start gap-3 p-3.5 hover:bg-rule-faint/60 transition-colors group/item focus:outline-none focus:bg-rule-faint last:rounded-b-[34px]"
            data-resume-item
          >
            <div class="mt-0.5 text-ink-soft group-hover/item:text-moss transition-colors">
              <Icon name="download" size={14} />
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-1">
                <span class="font-display text-sm font-semibold text-black group-hover/item:text-moss transition-colors truncate">
                  {item.role}
                </span>
                <span class="text-ink-faint text-[0.65rem] font-mono shrink-0">CV</span>
              </div>
              {item.subtitle && (
                <p class="text-xs text-ink-soft mt-0.5 font-sans leading-tight">
                  {item.subtitle}
                </p>
              )}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</div>

<script>
  // Robust hover & click dropdown controller for resume buttons
  const initResumeDropdowns = () => {
    const containers = document.querySelectorAll(".resume-dropdown-container");

    const closeAll = () => {
      containers.forEach((container) => {
        const toggle = container.querySelector<HTMLButtonElement>("[data-resume-toggle]");
        const menu = container.querySelector<HTMLElement>("[data-resume-menu]");
        const arrow = container.querySelector<HTMLElement>("[data-resume-arrow]");
        if (menu && !menu.hidden) {
          menu.hidden = true;
          toggle?.setAttribute("aria-expanded", "false");
          if (arrow) arrow.style.transform = "rotate(0deg)";
        }
      });
    };

    containers.forEach((container) => {
      const toggle = container.querySelector<HTMLButtonElement>("[data-resume-toggle]");
      const menu = container.querySelector<HTMLElement>("[data-resume-menu]");
      const arrow = container.querySelector<HTMLElement>("[data-resume-arrow]");

      if (!toggle || !menu) return;

      let closeTimer: ReturnType<typeof setTimeout> | null = null;

      const open = () => {
        if (closeTimer) {
          clearTimeout(closeTimer);
          closeTimer = null;
        }

        // Close other dropdowns
        containers.forEach((other) => {
          if (other !== container) {
            const otherMenu = other.querySelector<HTMLElement>("[data-resume-menu]");
            const otherToggle = other.querySelector<HTMLButtonElement>("[data-resume-toggle]");
            const otherArrow = other.querySelector<HTMLElement>("[data-resume-arrow]");
            if (otherMenu && !otherMenu.hidden) {
              otherMenu.hidden = true;
              otherToggle?.setAttribute("aria-expanded", "false");
              if (otherArrow) otherArrow.style.transform = "rotate(0deg)";
            }
          }
        });

        menu.hidden = false;
        toggle.setAttribute("aria-expanded", "true");
        if (arrow) arrow.style.transform = "rotate(180deg)";
      };

      const close = (delay = 150) => {
        if (closeTimer) clearTimeout(closeTimer);
        closeTimer = setTimeout(() => {
          menu.hidden = true;
          toggle.setAttribute("aria-expanded", "false");
          if (arrow) arrow.style.transform = "rotate(0deg)";
        }, delay);
      };

      // Trigger open on hover (mouse enter)
      container.addEventListener("mouseenter", open);

      // Trigger close on mouse leave with grace period
      container.addEventListener("mouseleave", () => close(150));

      // Also support click / tap for touch screens and keyboard users
      toggle.addEventListener("click", (e) => {
        e.stopPropagation();
        if (menu.hidden) {
          open();
        } else {
          close(0);
        }
      });

      // Close menu when a resume link is clicked
      container.querySelectorAll("[data-resume-item]").forEach((item) => {
        item.addEventListener("click", () => {
          close(100);
        });
      });
    });

    // Close when clicking outside
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest(".resume-dropdown-container")) {
        closeAll();
      }
    });

    // Close when pressing Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeAll();
      }
    });
  };

  initResumeDropdowns();
  document.addEventListener("astro:page-load", initResumeDropdowns);
</script>
