---
interface Props {
  name: keyof typeof icons;
  size?: number;
  stroke?: number;
  class?: string;
}

const { name, size = 16, stroke = 1.5, class: className = "" } = Astro.props;

/* Brand marks are solid; everything else is a 24px stroked outline
   so weight stays consistent with the hairline rules used site-wide. */
const solid = new Set(["github", "linkedin", "x"]);

const icons = {
  "arrow-down": '<path d="M12 5v14"/><path d="m19 12-7 7-7-7"/>',
  "arrow-right": '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  "arrow-up-right": '<path d="M7 17 17 7"/><path d="M7 7h10v10"/>',
  "arrow-up": '<path d="M12 19V5"/><path d="m5 12 7-7 7 7"/>',
  mail: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 9.2 6.1a1.5 1.5 0 0 0 1.6 0L22 7"/>',
  phone:
    '<path d="M3 5.5A2.5 2.5 0 0 1 5.5 3h1.8a1 1 0 0 1 .95.68l1.2 3.5a1 1 0 0 1-.5 1.2l-1.6.8a11 11 0 0 0 5.47 5.47l.8-1.6a1 1 0 0 1 1.2-.5l3.5 1.2a1 1 0 0 1 .68.95v1.8A2.5 2.5 0 0 1 18.5 21h-.5C9.9 21 3 14.1 3 6Z"/>',
  "map-pin":
    '<path d="M20 10c0 5.5-6.5 11-8 11s-8-5.5-8-11a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.75"/>',
  code: '<path d="m9 17-5-5 5-5"/><path d="m15 7 5 5-5 5"/>',
  download:
    '<path d="M12 3v11"/><path d="m7.5 10 4.5 4.5L16.5 10"/><path d="M4.5 19.5h15"/>',
  menu: '<path d="M3 7h18"/><path d="M3 15h18"/>',
  close: '<path d="M5 5l14 14"/><path d="M19 5 5 19"/>',
  send: '<path d="M21 3 3 10.5l7 3.5 3.5 7Z"/><path d="M21 3 10 14"/>',
  layers:
    '<path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 13 9 5 9-5"/>',
  spark: '<path d="M12 4v6"/><path d="M12 14v6"/><path d="M4 12h6"/><path d="M14 12h6"/>',
  github:
    '<path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.91c.58.1.79-.25.79-.55v-1.92c-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.04-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.3 3.16 1.18a10.9 10.9 0 0 1 5.76 0C17.1 5.11 18.06 5.4 18.06 5.4c.62 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.7 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .3.21.66.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/>',
  linkedin:
    '<path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.47-.9 1.63-1.85 3.37-1.85 3.6 0 4.26 2.37 4.26 5.45v6.29ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13Zm1.78 13.02H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/>',
  x: '<path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.46l8.6-9.83L0 1.15h7.59l5.44 7.2 5.87-7.2Zm-1.29 19.5h2.04L6.48 3.24H4.29l13.32 17.41Z"/>',
} as const;

const isSolid = solid.has(name as string);
---

<svg
 width={size}
 height={size}
  viewBox="0 0 24 24"
 fill={isSolid ? "currentColor" : "none"}
 stroke={isSolid ? undefined : "currentColor"}
 stroke-width={isSolid ? undefined : stroke}
 stroke-linecap="round"
 stroke-linejoin="round"
 class={className}
 aria-hidden="true"
 focusable="false"
  set:html={icons[name]}
/>
