---
import { site } from "../data/site";
import Icon from "./Icon.astro";
import ResumeDropdown from "./ResumeDropdown.astro";
---

<section id="top">
  <div>
    <!-- Hero Editorial Grid (1.1fr .9fr layout like reference) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <!-- Left Column: Copy & CTAs (7 cols) -->
      <div class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left">
        <!-- Current Position Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-black bg-paper-warm mb-3 max-w-full">
          <span
            aria-hidden="true"
            class="h-2 w-2 shrink-0 rounded-full bg-moss animate-pulse"></span>
          <p class="font-mono text-xs font-semibold text-black tracking-wider truncate">
            Full Stack Engineer & AI Systems Developer
          </p>
        </div>

        <h1 class="mt-2 text-display font-display font-medium text-black leading-none">
          Hi, I'm <span class="italic text-moss">{site.name}</span>
        </h1>

        <p class="mt-3 font-display text-title min-h-[1.4em] flex items-center justify-center lg:justify-start">
          <span id="hero-typewriter">Full Stack Engineer</span>
          <span
            class="inline-block w-[2px] h-[1.1em] bg-moss ml-1 align-middle animate-pulse"
            aria-hidden="true"
          ></span>
        </p>

        <p class="measure mt-4 text-base leading-relaxed text-ink-soft">
          Specializing in scalable enterprise web applications, complex business logic workflows,
          and robust API architectures. Currently architecting Factory OS (Manufacturing ERP) and engineering core
          features for an enterprise applicant tracking platform.
        </p>

        <!-- Call to Actions -->
        <div class="mt-6 flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">
          <a href="#work" class="btn btn-solid w-full sm:w-auto max-w-xs justify-center">
            See selected work
            <Icon name="arrow-down" size={15} />
          </a>
          <ResumeDropdown class="w-full sm:w-auto max-w-xs flex justify-center" />
          <a href={`mailto:${site.email}`} class="btn btn-ghost w-full sm:w-auto max-w-xs justify-center">
            <Icon name="mail" size={15} />
            Get in touch
          </a>
        </div>
      </div>

      <!-- Right Column: Soni-style Offset Shadow Portrait Frame (5 cols) -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="relative w-full max-w-[320px] sm:max-w-[360px] lg:max-w-none">
          <!-- Offset terracotta shadow plate (Soni brutalist effect) -->
          <!-- <div class="absolute inset-0 translate-x-3 translate-y-3 sm:translate-x-4 sm:translate-y-4 bg-moss border-2 border-black rounded-3xl" aria-hidden="true"></div> -->

          <!-- Main Portrait Box -->
          <div class="relative overflow-hidden  flex items-center justify-center p-4 aspect-[4/5]">
            <img
              src="/outline_prince_bavishi.svg"
              alt="Prince Bavishi - Full Stack Engineer"
              class="w-full h-full object-contain filter drop-shadow-sm transition-transform duration-300 hover:scale-[1.02]"
              loading="eager"
            />
            
            <!-- Bottom Corner Status Tab -->
            <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between px-3 py-1.5 rounded-xl border border-black bg-paper/95 backdrop-blur-sm font-mono text-[0.7rem]">
              <span class="flex items-center gap-1.5 font-bold text-black">
                <span class="w-2 h-2 rounded-full bg-moss"></span>
                ACTIVE
              </span>
              <span class="text-ink-soft">Ahmedabad / Rajkot, IN</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Facts Strip -->
    <div
      class="bleed relative mt-8 flex flex-col md:flex-row items-center justify-between gap-6 border-t border-rule-strong pt-5 pb-1"
    >
      <dl class="flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left gap-4 sm:gap-8 max-w-2xl">
        <div class="text-center sm:text-left shrink-0">
          <dt class="tag">Experience</dt>
          <dd class="mt-0.5 text-sm font-medium">1+ year</dd>
        </div>
        <div class="text-center sm:text-left">
          <dt class="tag">Status</dt>
          <dd class="mt-0.5 text-sm text-ink-soft">{site.availability}</dd>
        </div>
      </dl>
      <ul class="flex items-center justify-center list-none gap-2 shrink-0 md:ml-auto">
        <li>
          <a
            href={site.github}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-btn"
            aria-label="GitHub profile"
          >
            <Icon name="github" size={15} />
          </a>
        </li>
        <li>
          <a
            href={site.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-btn"
            aria-label="LinkedIn profile"
          >
            <Icon name="linkedin" size={15} />
          </a>
        </li>
        <li>
          <a
            href={`mailto:${site.email}`}
            class="icon-btn"
            aria-label="Send an email"
          >
            <Icon name="mail" size={15} />
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<script>
  const initTypewriter = () => {
    const el = document.getElementById("hero-typewriter");
    if (!el) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return;
    }

    const roles = [
      "Full Stack Engineer",
      "AI Systems Developer",
      "Angular & Nest.js Developer",
      "Enterprise Systems Architect",
    ];

    let roleIndex = 0;
    let charIndex = roles[0].length;
    let isDeleting = true;
    let timer: ReturnType<typeof setTimeout> | null = null;

    const tick = () => {
      const currentRole = roles[roleIndex];

      if (isDeleting) {
        charIndex--;
        el.textContent = currentRole.substring(0, charIndex);

        if (charIndex === 0) {
          isDeleting = false;
          roleIndex = (roleIndex + 1) % roles.length;
          timer = setTimeout(tick, 350);
          return;
        }
        timer = setTimeout(tick, 35);
      } else {
        charIndex++;
        el.textContent = currentRole.substring(0, charIndex);

        if (charIndex === currentRole.length) {
          isDeleting = true;
          timer = setTimeout(tick, 2200);
          return;
        }
        timer = setTimeout(tick, 75);
      }
    };

    timer = setTimeout(tick, 2200);
  };

  initTypewriter();
  document.addEventListener("astro:page-load", initTypewriter);
</script>
