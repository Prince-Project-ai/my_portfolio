---
import { site } from "../data/site";
import Icon from "./Icon.astro";
import ResumeDropdown from "./ResumeDropdown.astro";
import StackDiagram from "./StackDiagram.astro";
---

<section id="top" class="pt-8 pb-10 md:pt-12 md:pb-5">
  <div>
    <div class="flex flex-col items-center text-center">
      <!-- Copy -->
      <div class="max-w-3xl">
        <div class="flex items-center justify-center gap-2">
          <span
            aria-hidden="true"
            class="h-1.5 w-1.5 shrink-0 rounded-full bg-moss"></span>
          <p class="eyebrow">Software Engineer @ Softrefine Technology</p>
        </div>

        <h1 class="mt-4 text-display">
          Hi, I'm <span class="italic text-moss">{site.name}</span>
        </h1>

        <p class="mt-2 font-display text-title min-h-[1.4em] flex items-center justify-center">
          <span id="hero-typewriter">Full Stack Engineer</span>
          <span
            class="inline-block w-[2px] h-[1.1em] bg-moss ml-1 align-middle animate-pulse"
            aria-hidden="true"
          ></span>
        </p>

        <p class="measure mx-auto mt-4 text-base leading-relaxed text-ink-soft">
          Full Stack Engineer specializing in scalable enterprise web applications, complex business logic workflows,
          and robust API architectures. Currently architecting Factory OS (Manufacturing ERP) and engineering core
          features for a production multi-tenant Applicant Tracking System.
        </p>

        <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-3 w-full sm:w-auto">
          <a href="#work" class="btn btn-solid">
            See selected work
            <Icon name="arrow-down" size={15} />
          </a>
          <ResumeDropdown />
          <a href={`mailto:${site.email}`} class="btn btn-ghost">
            <Icon name="mail" size={15} />
            Get in touch
          </a>
        </div>
      </div>
    </div>

    <!-- Facts -->
    <div
      class="bleed relative mt-10 flex flex-wrap items-center justify-center gap-x-10 gap-y-4 border-t border-rule-strong pt-5"
    >
      <span
        aria-hidden="true"
        class="grid-corner-dot left-0 -translate-x-1/2 -translate-y-1/2"
      ></span>
      <span
        aria-hidden="true"
        class="grid-corner-dot right-0 translate-x-1/2 -translate-y-1/2"
      ></span>
      <dl class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
        <div>
          <dt class="tag">Experience</dt>
          <dd class="mt-0 text-sm">1+ year</dd>
        </div>
        <div>
          <dt class="tag">Status</dt>
          <dd class="mt-0 text-sm">{site.availability}</dd>
        </div>
      </dl>
      <ul class="ml-auto flex list-none gap-2">
        <li>
          <a
            href={site.github}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-btn"
            aria-label="GitHub profile"
          >
            <Icon name="github" size={15} />
          </a>
        </li>
        <li>
          <a
            href={site.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-btn"
            aria-label="LinkedIn profile"
          >
            <Icon name="linkedin" size={15} />
          </a>
        </li>
        <li>
          <a
            href={`mailto:${site.email}`}
            class="icon-btn"
            aria-label="Send an email"
          >
            <Icon name="mail" size={15} />
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<script>
  const initTypewriter = () => {
    const el = document.getElementById("hero-typewriter");
    if (!el) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return;
    }

    const roles = [
      "Full Stack Engineer",
      "Forward Deployed Engineer",
      "MERN Stack Developer",
      "PEAN Stack Developer",
    ];

    let roleIndex = 0;
    let charIndex = roles[0].length;
    let isDeleting = true;
    let timer: ReturnType<typeof setTimeout> | null = null;

    const tick = () => {
      const currentRole = roles[roleIndex];

      if (isDeleting) {
        charIndex--;
        el.textContent = currentRole.substring(0, charIndex);

        if (charIndex === 0) {
          isDeleting = false;
          roleIndex = (roleIndex + 1) % roles.length;
          timer = setTimeout(tick, 350);
          return;
        }
        timer = setTimeout(tick, 35);
      } else {
        charIndex++;
        el.textContent = currentRole.substring(0, charIndex);

        if (charIndex === currentRole.length) {
          isDeleting = true;
          timer = setTimeout(tick, 2200);
          return;
        }
        timer = setTimeout(tick, 75);
      }
    };

    // Give visitors 2.2s to read the initial role before cycling
    timer = setTimeout(tick, 2200);
  };

  initTypewriter();
  document.addEventListener("astro:page-load", initTypewriter);
</script>
