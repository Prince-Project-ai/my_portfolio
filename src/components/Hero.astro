---
import { site } from "../data/site";
import Icon from "./Icon.astro";
import StackDiagram from "./StackDiagram.astro";
---

<section id="top" class="pt-8 pb-10 md:pt-12 md:pb-5">
  <div>
    <div class="flex flex-col items-center text-center">
      <!-- Copy -->
      <div class="max-w-3xl">
        <div class="flex items-center justify-center gap-2">
          <span
            aria-hidden="true"
            class="h-1.5 w-1.5 shrink-0 rounded-full bg-moss"></span>
          <p class="eyebrow">Software Engineer @ Softrefine Technology</p>
        </div>

        <h1 class="mt-4 text-display">
          Hi, I'm <span class="italic text-moss">{site.name}</span>
        </h1>

        <p class="mt-2 font-display text-title">Full Stack Engineer</p>

        <p class="measure mx-auto mt-4 text-base leading-relaxed text-ink-soft">
          I build web applications end to end — reusable Angular and React interfaces
          on the front, REST APIs and data models behind them. Right now I'm a freelance developer 
          helping businesses build custom solutions like Factory OS, and working on an 
          AI-Powered Enterprise Applicant Tracking System (ATS) at Softrefine Technology.
        </p>

        <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-3 w-full sm:w-auto">
          <a href="#work" class="btn btn-solid">
            See selected work
            <Icon name="arrow-down" size={15} />
          </a>
          <a
            href={site.resume}
            download
            class="btn btn-ghost"
            aria-label="Download my resume as a PDF"
          >
            <Icon name="download" size={15} />
            Download resume
          </a>
          <a href={`mailto:${site.email}`} class="btn btn-ghost">
            <Icon name="mail" size={15} />
            Get in touch
          </a>
        </div>
      </div>
    </div>

    <!-- Facts -->
    <div
      class="bleed mt-10 flex flex-wrap items-center justify-center gap-x-10 gap-y-4 border-t border-dashed border-rule-strong pt-5"
    >
      <dl class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
        <div>
          <dt class="tag">Experience</dt>
          <dd class="mt-0 text-sm">1+ year</dd>
        </div>
        <div>
          <dt class="tag">Status</dt>
          <dd class="mt-0 text-sm">{site.availability}</dd>
        </div>
      </dl>
      <ul class="ml-auto flex list-none gap-2">
        <li>
          <a
            href={site.github}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-btn"
            aria-label="GitHub profile"
          >
            <Icon name="github" size={15} />
          </a>
        </li>
        <li>
          <a
            href={site.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-btn"
            aria-label="LinkedIn profile"
          >
            <Icon name="linkedin" size={15} />
          </a>
        </li>
        <li>
          <a
            href={`mailto:${site.email}`}
            class="icon-btn"
            aria-label="Send an email"
          >
            <Icon name="mail" size={15} />
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>
