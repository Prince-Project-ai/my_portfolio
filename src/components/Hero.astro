---
import { site } from "../data/site";
import Icon from "./Icon.astro";
import StackDiagram from "./StackDiagram.astro";
---

<section id="top" class="pt-24">
  <div class="wrap">
    <div class="grid-12 items-center">
      <!-- Copy -->
      <div class="col-span-12 lg:col-span-7">
        <div class="flex items-center gap-3">
          <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-moss"></span>
          <p class="eyebrow">Software Engineer @ Softrefine Technology</p>
        </div>

        <h1 class="mt-6 text-display">
          Hi, I'm
          <span class="block italic text-moss">{site.name}</span>
        </h1>

        <p class="mt-4 font-display text-title">
          Full Stack Engineer
        </p>

        <p class="measure mt-5 text-lg leading-relaxed text-ink-soft">
          I build web applications end to end — reusable Angular and React interfaces
          on the front, REST APIs and data models behind them. Right now I'm at
          Softrefine Technology, working across three modules of an AI-assisted
          applicant tracking system, where I made one of them roughly 40% faster.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="#work" class="btn btn-solid">
            See selected work
            <Icon name="arrow-down" size={15} />
          </a>
          <a
 href={site.resume}
            download
 class="btn btn-ghost"
 aria-label="Download my resume as a PDF"
          >
            <Icon name="download" size={15} />
            Download resume
          </a>
          <a href={`mailto:${site.email}`} class="btn btn-ghost">
            <Icon name="mail" size={15} />
            Get in touch
          </a>
        </div>
      </div>

      <!-- Illustration -->
      <div class="col-span-12 mt-12 lg:col-span-5 lg:mt-0">
        <StackDiagram />
      </div>
    </div>

    <!-- Facts -->
    <div class="mt-12 flex flex-wrap items-end gap-x-10 gap-y-4 border-t border-rule pt-6">
      <dl class="flex flex-wrap items-end gap-x-10 gap-y-4">
        <div>
          <dt class="tag">Experience</dt>
          <dd class="mt-1 text-sm">1+ year</dd>
        </div>
        <div>
          <dt class="tag">Status</dt>
          <dd class="mt-1 text-sm">{site.availability}</dd>
        </div>
      </dl>
      <ul class="ml-auto flex list-none gap-2">
        <li>
          <a
 href={site.github}
 target="_blank"
 rel="noopener noreferrer"
 class="icon-btn"
 aria-label="GitHub profile"
          >
            <Icon name="github" size={15} />
          </a>
        </li>
        <li>
          <a
 href={site.linkedin}
 target="_blank"
 rel="noopener noreferrer"
 class="icon-btn"
 aria-label="LinkedIn profile"
          >
            <Icon name="linkedin" size={15} />
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email}`} class="icon-btn" aria-label="Send an email">
            <Icon name="mail" size={15} />
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>