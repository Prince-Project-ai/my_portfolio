---
import { site } from "../data/site";
import Icon from "./Icon.astro";
import ResumeDropdown from "./ResumeDropdown.astro";
---

<section id="contact" class="section">
  <div>
    <div class="section-head">
      <p class="eyebrow">05 — Contact</p>
      <h2 class="mt-3 text-headline">
        Let's talk about <span class="italic text-moss">what you're building</span>
      </h2>
      <p class="measure text-ink-soft">
        Email is the most reliable way to reach me. I read everything and reply
        within a day or two.
      </p>
    </div>

    <div class="grid-12">
      <!-- Direct details -->
      <div class="col-span-12 space-y-4 md:col-span-4">
        <div class="flex items-start gap-3">
          <span class="icon-dot">
            <Icon name="mail" size={13} />
          </span>
          <div>
            <p class="tag">Email</p>
            <a href={`mailto:${site.email}`} class="link mt-0.5 inline-block text-sm">
              {site.email}
            </a>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="icon-dot">
            <Icon name="phone" size={13} />
          </span>
          <div>
            <p class="tag">Phone</p>
            <a href={site.phoneHref} class="link mt-0.5 inline-block text-sm">{site.phone}</a>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="icon-dot">
            <Icon name="map-pin" size={13} />
          </span>
          <div>
            <p class="tag">Location</p>
            <p class="mt-0.5 text-sm text-ink-soft">{site.location}</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <span class="icon-dot">
            <Icon name="spark" size={13} />
          </span>
          <div>
            <p class="tag">Status</p>
            <p class="mt-0.5 text-sm text-ink-soft">{site.availability}</p>
          </div>
        </div>

        <ResumeDropdown size="sm" align="left" />

        <div>
          <p class="tag">Elsewhere</p>
          <div class="mt-2 flex gap-2">
            <a
              href={site.github}
              target="_blank"
              rel="noopener noreferrer"
              class="icon-btn"
              aria-label="GitHub profile"
            >
              <Icon name="github" size={15} />
            </a>
            <a
              href={site.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="icon-btn"
              aria-label="LinkedIn profile"
            >
              <Icon name="linkedin" size={15} />
            </a>
            <a
              href={site.twitter}
              target="_blank"
              rel="noopener noreferrer"
              class="icon-btn"
              aria-label="X profile"
            >
              <Icon name="x" size={14} />
            </a>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="col-span-12 mt-8 md:col-span-7 md:col-start-6 md:mt-0">
        <form id="contact-form" novalidate>
          
          <div class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2">
            <div>
              <label for="name" class="tag">Name</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder="Your name"
                class="field mt-2"
              />
            </div>
            <div>
              <label for="email" class="tag">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="you@company.com"
                class="field mt-2"
              />
            </div>
          </div>

          <div class="mt-4">
            <label for="service" class="tag">Service</label>
            <select id="service" name="service" class="field mt-2 cursor-pointer bg-transparent">
              <option value="N/A">N/A</option>
              <option value="Web development">Web development</option>
              <option value="Video editor">Video editor</option>
              <option value="UI/UX design">UI/UX design</option>
              <option value="Custom software">Custom software</option>
              <option value="AI automation">AI automation</option>
              <option value="SEO optimization">SEO optimization</option>
            </select>
          </div>

          <div class="mt-4">
            <label for="message" class="tag">Message</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              placeholder="What are you working on?"
              class="field mt-2 resize-none"></textarea>
          </div>

          <div class="mt-5 flex flex-wrap items-center gap-4">
            <button type="submit" class="btn btn-solid" data-submit>
              <Icon name="send" size={14} />
              <span data-label>Send message</span>
            </button>
            <p id="form-status" role="status" aria-live="polite" class="text-sm text-ink-faint">
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");
  const button = document.querySelector<HTMLButtonElement>("[data-submit]");
  const label = document.querySelector<HTMLElement>("[data-label]");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form || !status || !button || !label) return;

    if (!form.checkValidity()) {
      status.textContent = "Please complete every field with a valid email.";
      status.className = "text-sm text-moss";
      form.querySelector<HTMLInputElement | HTMLTextAreaElement>(":invalid")?.focus();
      return;
    }

    button.disabled = true;
    label.textContent = "Sending";
    status.textContent = "";

    const formData = new FormData(form);

    // 1. ADD YOUR WEB3FORMS ACCESS KEY HERE
    // Get a free key at: https://web3forms.com/
    formData.append("access_key", "fd6efc3c-915c-48ed-b18b-b255f63ceabf");
    formData.append("subject", "New Lead from Portfolio");
    formData.append("from_name", "Portfolio Contact Form");

    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        body: formData, // Web3Forms accepts FormData directly
      });

      const result = await response.json();

      if (result.success) {
        form.reset();
        status.textContent = "Received. I'll be in touch shortly.";
        status.className = "text-sm text-moss";
      } else {
        throw new Error(result.message || "Failed to send");
      }
    } catch (error) {
      console.error(error);
      status.textContent = "Something failed. Please email me directly.";
      status.className = "text-sm text-moss";
    } finally {
      button.disabled = false;
      label.textContent = "Send message";
    }
  });
</script>
