---
// Marquee.astro

const services = [
  "Web Development",
  "UI/UX Design",
  "Custom Software",
  "AI Automation",
  "SEO Optimization"
];
---

<div class="relative w-full border-t border-rule-strong">
  <span
    aria-hidden="true"
    class="grid-corner-dot left-1 sm:left-0 sm:-translate-x-1/2 -translate-y-1/2"
  ></span>
  <span
    aria-hidden="true"
    class="grid-corner-dot right-1 sm:right-0 sm:translate-x-1/2 -translate-y-1/2"
  ></span>
  <div class="group flex overflow-hidden bg-rule-faint/30 py-3">
    <div class="animate-marquee flex min-w-full shrink-0 items-center justify-around gap-8 pr-8 group-hover:![animation-play-state:paused]">
      {
        services.map((service) => (
          <>
            <span class="font-mono text-xs uppercase tracking-widest text-ink-soft whitespace-nowrap">
              {service}
            </span>
            <span class="text-moss text-[0.65rem]">✦</span>
          </>
        ))
      }
    </div>
    
    <div aria-hidden="true" class="animate-marquee flex min-w-full shrink-0 items-center justify-around gap-8 pr-8 group-hover:![animation-play-state:paused]">
      {
        services.map((service) => (
          <>
            <span class="font-mono text-xs uppercase tracking-widest text-ink-soft whitespace-nowrap">
              {service}
            </span>
            <span class="text-moss text-[0.65rem]">✦</span>
          </>
        ))
      }
    </div>
  </div>
</div>
