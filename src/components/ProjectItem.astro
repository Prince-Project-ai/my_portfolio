---
import type { Project } from "../data/site";
import Icon from "./Icon.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const isFeatured = Boolean(project.featured);
---

<li class="border-b border-rule">
  <article
 class="grid gap-x-8 gap-y-4 py-8 md:grid-cols-[3.5rem_1fr] md:py-10"
  >
    <!-- Index rail: fixed width so every entry aligns on the same axis -->
    <div class="flex items-baseline gap-3 md:flex-col md:gap-1">
      <p class="font-display text-2xl leading-none text-moss">{project.index}</p>
      <p class="meta md:mt-1">{project.year}</p>
    </div>

    <!-- Content: single left-aligned column, nothing right-ragged -->
    <div>
      <!-- Kind + featured flag -->
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <p class="tag">{project.kind}</p>
        {
          isFeatured && (
            <span class="chip !border-moss !py-0.5 !text-[0.625rem] !text-moss">Featured</span>
          )
        }
      </div>

      <!-- Title -->
      <h3 class:list={["mt-2 font-display", isFeatured ? "text-headline" : "text-title"]}>
        {project.title}
      </h3>

      <!-- Summary -->
      <p class="measure mt-3 leading-relaxed text-ink-soft">{project.summary}</p>

      <!-- What I actually did -->
      <div class="measure mt-5 border-l-2 border-moss pl-4">
        <p class="tag">My contribution</p>
        <p class="mt-1 text-sm leading-relaxed">{project.contribution}</p>
      </div>

      <!-- Stack: one full-width line, left aligned -->
      <ul class="mt-6 flex flex-wrap gap-1.5">
        {project.stack.map((tech) => <li class="pill">{tech}</li>)}
      </ul>

      <!-- Actions -->
      <div class="mt-6 flex flex-wrap items-center gap-2">
        {
          project.live && (
            <a
 href={project.live}
 target="_blank"
 rel="noopener noreferrer"
 class="btn btn-solid btn-sm"
            >
              View live
              <Icon name="arrow-up-right" size={13} />
            </a>
          )
        }
        {
          project.repo && (
            <a
 href={project.repo}
 target="_blank"
 rel="noopener noreferrer"
 class="btn btn-ghost btn-sm"
            >
              <Icon name="github" size={13} />
              Source
            </a>
          )
        }
        {
          project.confidential && (
            <span class="flex items-center gap-2 text-sm text-ink-faint">
              <Icon name="code" size={13} />
              Private codebase — company product
            </span>
          )
        }
      </div>
    </div>
  </article>
</li>
