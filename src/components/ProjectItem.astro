---
import type { Project } from "../data/site";
import Icon from "./Icon.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const isFeatured = Boolean(project.featured);
---

<li class="flex flex-col border border-rule-strong p-6 md:p-8 h-full squircle-box overflow-hidden bg-paper transition-shadow duration-300">
  <article class="flex flex-col flex-1">
    <!-- Index and Year header -->
    <div class="flex items-baseline justify-between border-b border-rule-strong pb-4 mb-4">
      <p class="font-display text-2xl leading-none text-moss">{project.index}</p>
      <p class="meta">{project.year}</p>
    </div>

    <!-- Kind -->
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <p class="tag">{project.kind}</p>
      {
        isFeatured && (
          <span class="chip !border-moss !py-0.5 !text-[0.625rem] !text-moss">Featured</span>
        )
      }
    </div>

    <!-- Title -->
    <h3 class="mt-3 font-display text-xl text-black md:text-2xl">
      {project.title}
    </h3>

    <!-- Summary -->
    <p class="mt-2 leading-relaxed text-ink-soft text-sm">{project.summary}</p>

    <!-- What I actually did -->
    <div class="mt-4 border-l border-moss pl-4">
      <p class="tag">My contribution</p>
      <p class="mt-1 text-sm leading-relaxed">{project.contribution}</p>
    </div>

    <!-- Stack and Actions pushed to bottom -->
    <div class="mt-auto pt-6">
      <ul class="flex flex-wrap gap-1.5 mb-5">
        {project.stack.map((tech) => <li class="pill">{tech}</li>)}
      </ul>

      <!-- Actions -->
      <div class="flex flex-wrap items-center gap-2">
        {
          project.live && (
            <a
              href={project.live}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-solid btn-sm"
            >
              View live
              <Icon name="arrow-up-right" size={13} />
            </a>
          )
        }
        {
          project.repo && (
            <a
              href={project.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-ghost btn-sm"
            >
              <Icon name="github" size={13} />
              Source
            </a>
          )
        }
        {
          project.confidential && (
            <span class="flex items-center gap-2 text-sm text-ink-faint">
              <Icon name="code" size={13} />
              Private product
            </span>
          )
        }
      </div>
    </div>
  </article>
</li>
