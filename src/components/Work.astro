---
import { projects, site } from "../data/site";
import ProjectSplitArchCard from "./ProjectSplitArchCard.astro";
---

<section id="work" class="section relative">
  <div>
    <!-- Section Head -->
    <div class="section-head flex flex-col md:flex-row md:items-end md:justify-between gap-4 pb-6 border-b-2 border-black mb-10">
      <div>
        <p class="eyebrow text-moss font-bold">01 — Work</p>
        <h2 class="mt-2 text-headline">Selected Projects</h2>
        <p class="measure text-ink-soft text-sm sm:text-base">
          Production enterprise platforms, complex SaaS workflows, and full-stack software solutions.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <span class="font-mono text-xs text-ink-faint">4 Featured Projects</span>
      </div>
    </div>

    <!-- STACKING SCROLL CONTAINER -->
    <div class="relative project-stack-container">
      {projects.map((project, idx) => (
        <ProjectSplitArchCard project={project} index={idx} />
      ))}
    </div>

    <!-- Section Footer
    <div class="mt-8 pt-6 border-t-2 border-black flex flex-wrap items-center justify-between text-sm text-ink-faint">
      <p>
        Additional client tools and open-source builds live on
        <a href={site.github} target="_blank" rel="noopener noreferrer" class="link text-ink font-bold">
          GitHub
        </a>.
      </p>
      <span class="font-mono text-xs text-moss font-bold">End of Selected Work</span>
    </div> -->
  </div>
</section>
