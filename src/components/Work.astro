---
import { projects, site } from "../data/site";
import ProjectItem from "./ProjectItem.astro";

/* Featured first, then everything else — one continuous list. */
const ordered = [
  ...projects.filter((project) => project.featured),
  ...projects.filter((project) => !project.featured),
];
---

<section id="work" class="section">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">01 — Work</p>
      <h2 class="mt-3 text-headline">Selected work</h2>
      <p class="measure mt-3 text-ink-soft">
        A company product I work on daily, and two I built on my own.
      </p>
    </div>

    <ol class="border-t border-rule">
      {ordered.map((project) => <ProjectItem project={project} />)}
    </ol>

    <p class="mt-6 text-sm text-ink-faint">
      Smaller experiments and practice builds live on
      <a href={site.github} target="_blank" rel="noopener noreferrer" class="link">
        GitHub
      </a>.
    </p>
  </div>
</section>
