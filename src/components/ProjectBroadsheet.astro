---
import type { Project } from "../data/site";
import Icon from "./Icon.astro";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="border-y-2 border-black divide-y-2 divide-black my-8 bg-paper">
  {projects.map((project) => (
    <article class="py-8 md:py-10 transition-colors duration-200 hover:bg-rule-faint/40 px-2 sm:px-4 group">
      <!-- Top meta line -->
      <div class="flex flex-wrap items-baseline justify-between gap-3 font-mono text-xs text-ink-faint mb-3">
        <div class="flex items-center gap-3">
          <span class="font-bold text-moss text-sm">NO. {project.index}</span>
          <span class="uppercase tracking-widest">// {project.kind}</span>
        </div>
        <div>
          <span>RELEASE / {project.year}</span>
        </div>
      </div>

      <!-- Main editorial grid: Title & Summary on Left, Technical Evidence on Right -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10">
        <!-- Col 1: Big Headline + Summary (7 cols) -->
        <div class="lg:col-span-7">
          <h3 class="font-display text-2xl sm:text-3xl lg:text-4xl font-bold text-black group-hover:text-moss transition-colors duration-150 leading-tight">
            {project.title}
          </h3>
          <p class="mt-3 text-base text-ink-soft leading-relaxed font-sans">
            {project.summary}
          </p>

          <div class="mt-4 flex flex-wrap gap-1.5">
            {project.stack.map((item) => (
              <span class="font-mono text-xs border border-rule-strong px-2 py-0.5 rounded text-ink bg-paper">
                {item}
              </span>
            ))}
          </div>
        </div>

        <!-- Col 2: Engineering Execution & Actions (5 cols) -->
        <div class="lg:col-span-5 flex flex-col justify-between border-t lg:border-t-0 lg:border-l-2 border-black pt-4 lg:pt-0 lg:pl-8">
          <div>
            <span class="font-mono text-[0.7rem] uppercase tracking-widest text-moss font-bold block mb-1">
              [ Architectural Role & Impact ]
            </span>
            <p class="text-sm font-sans text-ink leading-relaxed">
              {project.contribution}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-rule-strong flex items-center gap-3">
            {project.live && (
              <a href={project.live} target="_blank" rel="noopener noreferrer" class="btn btn-solid btn-sm text-xs">
                Inspect Live Site
                <Icon name="arrow-up-right" size={13} />
              </a>
            )}
            {project.repo && (
              <a href={project.repo} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm text-xs">
                Source Code
                <Icon name="github" size={14} />
              </a>
            )}
            {project.confidential && (
              <span class="font-mono text-xs text-ink-faint italic">
                🔒 Enterprise NDA / Protected Codebase
              </span>
            )}
          </div>
        </div>
      </div>
    </article>
  ))}
</div>
