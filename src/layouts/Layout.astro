---
import { site } from "../data/site";
import "../index.css";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
}

const {
  title = "Prince Bavishi - Full Stack Engineer",
  description =
    "Prince Bavishi is a Full Stack Developer with 1.5+ years of experience building and maintaining production SaaS applications across MERN and MEAN stacks (React.js, Angular, Node.js, NestJS, TypeScript) with PostgreSQL and MongoDB. Experienced in CRM/ERP applications, RESTful APIs, JWT/RBAC and AI-assisted development.",
  keywords =
    "Prince Bavishi, Full Stack Engineer, Full Stack Developer, Full Stack Engineer India, Full Stack Developer India, Software Engineer India, Angular Developer, React Developer, Node.js Developer, Express.js Developer, NestJS Developer, TypeScript Developer, JavaScript Developer, Frontend Engineer, Backend Developer, MEAN Stack Developer, MERN Stack Developer, REST API Development, SQL Developer, MySQL, PostgreSQL, MongoDB, Supabase, JWT Authentication, RBAC, Tailwind CSS, PrimeNG, Angular Material, RxJS, Signals, Docker, Azure DevOps, Git, AI-Assisted Development, Google Antigravity, OpenAI Codex, Claude, CRM Development, ERP Development, Portfolio",
  ogImage = "/og-image.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImageURL = new URL(ogImage, Astro.site ?? site.url).href;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Prince Bavishi",
  alternateName: "Prince Bavishi — Full Stack Engineer",
  url: site.url,
  image: ogImageURL,
  jobTitle: "Full Stack Engineer",
  description:
    "Full Stack Developer with 1.5+ years of experience building and maintaining production SaaS applications across MERN and MEAN stacks (React.js, Angular, Node.js, NestJS, TypeScript) with PostgreSQL and MongoDB.",
  email: `mailto:${site.email}`,
  telephone: site.phone,
  nationality: { "@type": "Country", name: "India" },
  worksFor: {
    "@type": "Organization",
    name: "World Annex Infotech",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Amreli",
      addressRegion: "Gujarat",
      addressCountry: "IN",
    },
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Amreli",
    addressRegion: "Gujarat",
    addressCountry: "IN",
  },
  sameAs: [site.github, site.linkedin, site.twitter],
  alumniOf: [
    {
      "@type": "EducationalOrganization",
      name: "Dr. Babasaheb Ambedkar Open University",
      address: { "@type": "PostalAddress", addressLocality: "Rajkot", addressCountry: "IN" },
    },
    {
      "@type": "EducationalOrganization",
      name: "Saurashtra University",
      address: { "@type": "PostalAddress", addressLocality: "Rajkot", addressCountry: "IN" },
    },
  ],
  hasOccupation: {
    "@type": "Occupation",
    name: "Full Stack Engineer",
    occupationLocation: { "@type": "Country", name: "India" },
    skills:
      "React.js, Angular, TypeScript, JavaScript, Node.js, Express.js, NestJS, RESTful APIs, JWT Authentication, RBAC, MongoDB, PostgreSQL, MySQL, Supabase, Tailwind CSS, Azure DevOps, Docker, Git, AI-Assisted Development",
  },
  knowsAbout: [
    "Full Stack Development",
    "MERN Stack",
    "MEAN Stack",
    "Angular",
    "React.js",
    "TypeScript",
    "JavaScript",
    "Node.js",
    "Express.js",
    "NestJS",
    "RESTful APIs",
    "JWT Authentication",
    "RBAC",
    "PostgreSQL",
    "MongoDB",
    "MySQL",
    "Supabase",
    "SQL",
    "HTML5",
    "CSS3",
    "SCSS",
    "Tailwind CSS",
    "Angular Material",
    "PrimeNG",
    "RxJS",
    "Signals",
    "AI-Assisted Development",
    "Prompt Engineering",
    "CRM Systems",
    "ERP Architecture",
    "Docker",
    "Azure DevOps",
    "Git",
    "Web Performance Optimization",
    "Software Architecture",
  ],
  knowsLanguage: ["English", "Hindi", "Gujarati"],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Prince Bavishi — Full Stack Engineer",
  url: site.url,
  inLanguage: "en-IN",
  author: { "@type": "Person", name: "Prince Bavishi" },
};

const profilePageSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: { "@type": "Person", name: "Prince Bavishi" },
  url: canonicalURL,
  dateModified: new Date().toISOString(),
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Prince Bavishi" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="googlebot" content="index, follow" />
    <meta name="theme-color" content="#f6f1e9" />

    <link rel="canonical" href={canonicalURL} />

    <!-- Geo -->
    <meta name="geo.region" content="IN-GJ" />
    <meta name="geo.placename" content="Rajkot, Gujarat, India" />
    <meta name="ICBM" content="22.3039, 70.8022" />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Prince Bavishi — Full Stack Engineer" />
    <meta property="og:site_name" content="Prince Bavishi" />
    <meta property="og:locale" content="en_IN" />
    <meta property="profile:first_name" content="Prince" />
    <meta property="profile:last_name" content="Bavishi" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="Prince Bavishi — Full Stack Engineer" />
    <meta name="twitter:creator" content="@PrinceBavishi10" />
    <meta name="twitter:site" content="@PrinceBavishi10" />

    <!-- Icons and manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Space+Grotesk:wght@300..700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(profilePageSchema)} />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      Skip to content
    </a>
    <slot />

    <script>
      // Minimal, performant scroll reveal animation
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("revealed");
              observer.unobserve(entry.target);
            }
          });
        },
        { root: null, rootMargin: "0px 0px -50px 0px", threshold: 0 }
      );

      // Run initially
      document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));

      // Handle Astro view transitions if they ever get added
      document.addEventListener("astro:page-load", () => {
        document.querySelectorAll(".reveal:not(.revealed)").forEach((el) => observer.observe(el));
      });
    </script>
  </body>
</html>
